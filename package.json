{
  "name": "@sstolz/kdrive-mcp-server",
  "version": "0.6.0-beta.1",
  "description": "Beta, interface may change: unofficial MCP server for kDrive, not affiliated with Infomaniak",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "bin": {
    "kdrive-mcp-server": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sstolz/kdrive-mcp-server.git"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "coverage": "node scripts/coverage.ts",
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755);\"",
    "pack:check": "vitest run tests/package.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.12",
    "jpeg-js": "0.4.4",
    "pdfjs-dist": "6.5.438",
    "pngjs": "7.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.0",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
